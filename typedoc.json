{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/core/params.ts",
    "src/core/profile.ts",
    "src/core/mesh.ts",
    "src/core/shell.ts",
    "src/core/polygon.ts",
    "src/core/build.ts",
    "src/core/stl.ts",
    "src/core/metrics.ts",
    "src/core/validate.ts",
    "src/core/slicer.ts",
    "src/core/drainage.ts"
